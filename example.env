# --- Network ---
NEXTENDO_HOST=nextendo.example
# Public hostname clients connect to via SNI.
# Used to build the secure StationURL the console talks to next.

# --- Listeners ---
AUTH_PORT=443
# Where the insecure TicketGranting endpoint listens (fronted by sni-router).
SECURE_PORT=60005
# Where the secure game endpoint listens.
# MK8D=60003, Splatoon 2=60004, MHGU=60005 -- leave 60005 unless you have a conflict.

# --- TLS ---
CERT_FILE=cert.pem
KEY_FILE=key.pem
# Both endpoints call ListenSecure, so these are mandatory.

# --- Kerberos / secure-account ---
NEXTENDO_SECURE_PASSWORD=securepasswordplz1
# Shared between the auth endpoint and the secure endpoint; must match byte-for-byte.

# --- nextendo-account integration ---
NEXTENDO_ACCOUNT_URL=http://nextendo-account:3000
NEXTENDO_INTERNAL_KEY=changeme-internal-key
# Header value the account server expects on /internal/online-check.
NEXTENDO_REQUIRE_ACCOUNT=1
NEXTENDO_REQUIRE_SIGNED_TOKEN=1
# Default ON for MHGU -- there's no legacy emulator sending bare PIDs.

# --- Presence (reported to nextendo-account as "playing MHGU") ---
NEXTENDO_PRESENCE_INTERVAL=30s
NEXTENDO_SECRET=
NEXTENDO_SECRET_FILE=nextendo_secret.key
# Shared HMAC secret for signed nex-PID tokens. Read from env first, then hex file.

# --- Reaper (idle-connection eviction) ---
NEXTENDO_REAP_IDLE_SECONDS=600
NEXTENDO_REAP_EVERY_SECONDS=60
# Set idle to 0 to disable.

# --- Proxy protocol (Traefik front-end) ---
NEXTENDO_PROXY_PROTOCOL=0
# Set to 1 when running behind Traefik with PROXY protocol enabled on the auth listener.

# --- Dashboard / monitoring ---
DASH_PORT=8085
# MHGU dashboard (Splatoon=8082, MK8=8083/4, MHGU=8085).
DASH_TOKEN=
# Leave empty only on isolated networks. Empty + public = unauthenticated player/IP leak.

# --- Logging ---
LOG_LEVEL=info
# debug | info | warn | error